PORT=5001
# MongoDB Atlas connection string (replace <db_password> with your Atlas password):
MONGODB_URI=mongodb+srv://<username>:<db_password>@<cluster>.mongodb.net/hospital_booking?retryWrites=true&w=majority
# Or Local MongoDB Compass connection string:
# MONGODB_URI=mongodb://127.0.0.1:27017/hospital_booking
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d
NODE_ENV=development
CLIENT_URL=http://localhost:5173
